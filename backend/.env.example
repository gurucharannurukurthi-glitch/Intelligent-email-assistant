# Backend Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# MongoDB Connection String (Local or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/intelligent_email_assistant

# Session Secret (random 64+ character string recommended in production)
SESSION_SECRET=your_super_secret_session_key_at_least_32_characters_long

# Google OAuth 2.0 Credentials (from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# AI Provider Configuration ('gemini', 'openai', or 'anthropic')
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
AI_MODEL=gemini-2.5-flash

# Optional Alternate AI Providers
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key

# Vector Embeddings & MongoDB Atlas Vector Search
EMBEDDING_MODEL=gemini-embedding-001
ATLAS_VECTOR_INDEX=vector_index

# AES-256-GCM Token Encryption Key (64-character hex string = 32 bytes)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=your_64_character_hex_encryption_key_here

# Reverse Proxy & Cookie Settings (Production deployment)
TRUST_PROXY=1
# COOKIE_DOMAIN=.yourdomain.com
